-- trha multi-package project file.
-- The root trha.cabal (kernel + shell servers) and the standalone CLI
-- shell under packages/app/CLI (own trha-cli.cabal, brick TUI/REPL) are
-- both part of this project so builds work from either directory.
--
-- 构建产物落在 cabal 默认的 `dist-newstyle/`（已在 .gitignore）。
-- 注意：`builddir:` 不是 cabal.project 的合法字段——cabal 3.16 会打印
-- 「The builddir option is not supported」（被忽略），并且每次都让配置比对
-- 结果失配，于是 `cabal run` 反复全量重编。要改产物位置请用命令行
-- `cabal build --builddir=...`。
packages:
  .
  packages/app/CLI
  -- 2026-10-27 并入主线（P-02）：只保留 SDK 客户端面（Core.Types/Client/HTTP +
  -- Client.* + Utils.*）；重复的 Core.Server/Handlers、Types.Config、Server.Main
  -- 已归档到 archive/sdk-legacy/。
  packages/sdk
  -- 2026-10-26 接线（A 方案）：内核载体 C[A₄] + Plancherel 内积的唯一实现在
  -- sov-math（零浮点、强类型、170 项测试）。**不 vendor、不重写**——否则就是
  -- 「第二个实现无等价证明」。此处是相对路径依赖（trha 与 math 为兄弟目录）；
  -- 若 sov-math 迁移目录，只改这一行。
  ../math/hs/sov-math
  3rdparty/brick
