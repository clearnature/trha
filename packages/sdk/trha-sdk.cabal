cabal-version:      3.0
name:               trha-sdk
version:            0.1.0.0
synopsis:           SDK for trha agent harness
license:            MIT
author:             Yanli
build-type:         Simple

-- SDK Core
library trha-sdk-core
  exposed-modules:  
    Core.Types
    Core.Client
    Core.HTTP
  hs-source-dirs:   src-core
  build-depends:    base ^>=4.22
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
                  , directory
                  , time
                  , containers
  default-language: Haskell2010


-- SDK Client
library trha-sdk-client
  exposed-modules:
    Client.Session
    Client.Agent
    Client.Tool
    Client.Model
  hs-source-dirs:   src-client
  build-depends:    base ^>=4.22
                  , trha-sdk-core
                  , aeson
                  , text
  default-language: Haskell2010

-- SDK Utils
library trha-sdk-utils
  exposed-modules:  
    Utils.Logger
    Utils.Retry
  hs-source-dirs:   src-utils
  build-depends:    base ^>=4.22
                  , text
                  , time
  default-language: Haskell2010


-- SDK Test Suite
test-suite trha-sdk-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base ^>=4.22
                  , trha-sdk-core
                  , trha-sdk-client
                  , trha-sdk-utils
                  , hspec
                  , QuickCheck
                  , aeson
                  , text
  ghc-options:      -rtsopts
  default-language: Haskell2010