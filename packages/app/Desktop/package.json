{
  "name": "@trha/desktop",
  "version": "0.1.0",
  "description": "trha Desktop Application",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "test": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "export:studio": "vite build && rm -rf ../../scheduler/studio-public/* && cp -r dist/renderer/* ../../scheduler/studio-public/",
    "sync:scheduler": "node scripts/sync-scheduler.mjs",
    "package": "npm run sync:scheduler && npm run sync:node && electron-builder",
    "sync:node": "mkdir -p resources/node-runtime && cp \"$(which node)\" resources/node-runtime/node && chmod +x resources/node-runtime/node"
  },
  "keywords": [
    "desktop",
    "electron",
    "react",
    "trha"
  ],
  "author": "Yanli",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.0.0",
    "jsdom": "^22.1.0",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "winston": "^3.0.0",
    "zustand": "^4.0.0"
  },
  "homepage": "https://github.com/clearnature/trha"
}
