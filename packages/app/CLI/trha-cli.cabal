cabal-version:      3.0
name:               trha-cli
version:            0.1.0.0
synopsis:           CLI for trha agent harness
license:            MIT
author:             Yanli
build-type:         Simple


-- 注意：本包不再定义 executable。CLI 入口由仓库根的 trha.cabal 统一提供——
-- 两个包各定义一份同名 `executable trha` 时，`cabal run trha` / `cabal
-- list-bin trha` 会在两份独立编译的产物之间做隐式选择，很容易跑到旧的一份。
-- 本目录没有独立 cabal.project，构建会向上找到根 project，因此不需要副本。
test-suite trha-cli-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   ., test
  other-modules:
    Config.Settings
    Config.Home
    Config.HomeSpec
    Config.SettingsSpec
    Core.Args
    Core.Sandbox
    Core.ArgsSpec
    Core.HTTP
    Core.HTTPSpec
    Bridge.Scheduler
    BridgeDeltaSpec
    Core.SSE
    Core.SSESpec
    Core.Memory
    Core.MemorySpec
    Core.RunLog
    Core.RunLogSpec
    Core.RunState
    Core.RunStateSpec
    Core.ProjectStore
    Core.ProjectStoreSpec
    Core.StatePaths
    Core.StatePathsSpec
    Core.TypesSpec
    Core.Replay
    Core.ReplaySpec
    Core.Export
    Core.ExportSpec
    Core.TurnStatsSpec
    Core.EffortContractSpec
    Core.SessionSummary
    Core.SessionSummarySpec
    Core.Types
    UI.Render.Markdown
    UI.Render.MarkdownSpec
    UI.Render.Picker
    UI.Render.PickerSpec
    UI.Render.ToolCard
    UI.Render.ToolCardSpec
    UI.Render.ToolSummary
    UI.Render.ToolSummarySpec
    UI.Render.FilePart
    UI.Render.FilePartSpec
    UI.Render.Message
    UI.Render.MessageSpec
    UI.Theme
    UI.ThemeSpec
    UI.Setup
    UI.SetupSpec
    UI.IndexCache
    UI.IndexCacheSpec
    UI.CustomCommands
    UI.CustomCommandsSpec
    UI.ProviderPresets
    UI.Render.Footer
    UI.Render.FooterSpec
    UI.CommandsSpec
    UI.Commands.RegistrySpec
    UI.Commands.Registry
    UI.InputHistory
    UI.InputHistorySpec
    UI.Dialog
    UI.DialogSpec
    UI.Interaction
    UI.InteractionSpec
    UI.Layout
    UI.LayoutSpec
    UI.Completion
    UI.CompletionSpec
    UI.Keys
    UI.KeysSpec
    UI.Skills
    UI.SkillsSpec
    UI.SelectionSpec
    UI.TimeStampSpec
    UI.Stash
    UI.StashSpec
    UI.Frecency
    UI.FrecencySpec
    UI.ModelPrefs
    UI.ModelPrefsSpec
    UI.Render.Diff
    UI.Render.DiffSpec
    UI.Render.Sidebar
    UI.Render.SidebarSpec
    TestHome
  build-depends:    base ^>=4.22
                  , process
                  , trha:trha-infra
                  , hspec >= 2.10
                  , text
                  , aeson
                  , bytestring
                  , containers
                  , yaml
                  , directory
                  , filepath
                  , time
                  , optparse-applicative >= 0.18
                  , http-client
                  , http-client-tls
                  , connection
                  , http-types
                  , network
  if !os(windows)
    build-depends: unix
  default-language: Haskell2010
