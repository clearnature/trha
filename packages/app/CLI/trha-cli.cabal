cabal-version:      3.0
name:               trha-cli
version:            0.1.0.0
synopsis:           CLI for trha agent harness
license:            MIT
author:             Yanli
build-type:         Simple

-- Standalone build definition for the trha CLI shell.
-- Mirrors the executable stanza in the repository-root trha.cabal so that
-- `cd packages/app/CLI && cabal build` works on its own.
executable trha
  main-is:          Main.hs
  hs-source-dirs:   .
  other-modules:
    Bridge.Scheduler
    Config.Settings
    Config.Home
    Core.Args
    UI.Commands.Registry
    Core.HTTP
    Core.Transcript
    Core.Memory
    Core.PlanStore
    Core.ProjectStore
    Core.RunLog
    Core.RunState
    Core.StatePaths
    Core.SessionSummary
    Core.Replay
    Core.SSE
    Core.Clipboard
    Core.Currency
    Core.Export
    Core.Fonts
    Core.TurnStats
    Core.EffortContract
    Core.Types
    UI.Brick
    UI.Event
    UI.Commands
    UI.I18n
    UI.SettingsView
    UI.StatsView
    UI.StatusInfo
    UI.Render.Markdown
    UI.InputHistory
    UI.Dialog
    UI.Interaction
    UI.Layout
    UI.Completion
    UI.Keys
    UI.Skills
    UI.Selection
    UI.TimeStamp
    UI.Stash
    UI.Frecency
    UI.ModelPrefs
    UI.Render.Diff
    UI.Render.Sidebar
    UI.Render.Picker
    UI.Render.ToolCard
    UI.Render.ToolSummary
    UI.Render.Message
    UI.Theme
    UI.Setup
    UI.SetupWizard
    UI.IndexCache
    UI.CustomCommands
    UI.Render.Footer
    UI.TextWidth
    UI.ProviderPresets
  ghc-options:      -rtsopts -threaded
  build-depends:    base ^>=4.22
                  , trha:trha-api
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , connection
                  , http-types
                  , directory
                  , filepath
                  , ansi-terminal
                  , process
                  , brick >= 3.0
                  , microlens
                  , vty >= 6.1
                  , vty-crossplatform >= 0.4
                  , optparse-applicative >= 0.18
                  , stm
                  , containers
                  , async
                  , time
                  , haskeline >= 0.8
                  , yaml
                  , unix
  default-language: Haskell2010

test-suite trha-cli-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   ., test
  other-modules:
    Config.Settings
    Config.Home
    Config.HomeSpec
    Config.SettingsSpec
    Core.Args
    Core.ArgsSpec
    Core.HTTP
    Core.HTTPSpec
    Bridge.Scheduler
    BridgeDeltaSpec
    Core.SSE
    Core.SSESpec
    Core.Memory
    Core.MemorySpec
    Core.RunLog
    Core.RunLogSpec
    Core.RunState
    Core.RunStateSpec
    Core.ProjectStore
    Core.ProjectStoreSpec
    Core.StatePaths
    Core.StatePathsSpec
    Core.TypesSpec
    Core.Replay
    Core.ReplaySpec
    Core.Export
    Core.ExportSpec
    Core.TurnStatsSpec
    Core.EffortContractSpec
    Core.SessionSummary
    Core.SessionSummarySpec
    Core.Types
    UI.Render.Markdown
    UI.Render.MarkdownSpec
    UI.Render.Picker
    UI.Render.PickerSpec
    UI.Render.ToolCard
    UI.Render.ToolCardSpec
    UI.Render.ToolSummary
    UI.Render.ToolSummarySpec
    UI.Render.Message
    UI.Render.MessageSpec
    UI.Theme
    UI.ThemeSpec
    UI.Setup
    UI.SetupSpec
    UI.IndexCache
    UI.IndexCacheSpec
    UI.CustomCommands
    UI.CustomCommandsSpec
    UI.ProviderPresets
    UI.Render.Footer
    UI.Render.FooterSpec
    UI.CommandsSpec
    UI.Commands.RegistrySpec
    UI.Commands.Registry
    UI.InputHistory
    UI.InputHistorySpec
    UI.Dialog
    UI.DialogSpec
    UI.Interaction
    UI.InteractionSpec
    UI.Layout
    UI.LayoutSpec
    UI.Completion
    UI.CompletionSpec
    UI.Keys
    UI.KeysSpec
    UI.Skills
    UI.SkillsSpec
    UI.SelectionSpec
    UI.TimeStampSpec
    UI.Stash
    UI.StashSpec
    UI.Frecency
    UI.FrecencySpec
    UI.ModelPrefs
    UI.ModelPrefsSpec
    UI.Render.Diff
    UI.Render.DiffSpec
    UI.Render.Sidebar
    UI.Render.SidebarSpec
  build-depends:    base ^>=4.22
                  , hspec >= 2.10
                  , text
                  , aeson
                  , bytestring
                  , containers
                  , yaml
                  , directory
                  , filepath
                  , time
                  , unix
                  , optparse-applicative >= 0.18
                  , http-client
                  , http-client-tls
                  , connection
                  , http-types
                  , network
  default-language: Haskell2010
