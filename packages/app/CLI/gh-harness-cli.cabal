cabal-version:      3.0
name:               gh-harness-cli
version:            0.1.0.0
synopsis:           CLI for gh-harness agent harness
license:            MIT
author:             Yanli
build-type:         Simple

executable gh-harness-cli
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:    base ^>=4.22
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
                  , directory
                  , filepath
                  , ansi-terminal
  default-language: Haskell2010