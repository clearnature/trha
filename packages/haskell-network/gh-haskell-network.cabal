cabal-version:      3.0
name:               trha-network
version:            0.1.0.0
synopsis:           Haskell network library for trha
license:            MIT
author:             Yanli
build-type:         Simple

executable trha-network
  main-is:          Main.hs
  hs-source-dirs:   .
  build-depends:    base ^>=4.22
                  , warp
                  , wai
                  , http-types
                  , network
                  , aeson
                  , text
                  , bytestring
                  , stm
                  , containers
  default-language: Haskell2010