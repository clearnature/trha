{
  "name": "@trha/scheduler",
  "version": "0.1.0",
  "description": "TypeScript scheduler for trha",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest",
    "lint": "oxlint src",
    "clean": "rm -rf dist"
  },
  "engines": {
