#!/bin/sh
# Slower gates that would make every commit painful.
# Installed by scripts/install-hooks.sh (root postinstall).
#
# Timings on a warm tree: cabal test trha-test ~135s, scheduler
# coverage ~15s total. Full `cabal test all` (~6.5 min) and the
# full coverage report stay in CI.
#
# Desktop/Web 检查已于 2026-11-12 移除（客户端归档至 archive/）。
set -e

cd "$(git rev-parse --show-toplevel)"

out=$(mktemp)
trap 'rm -f "$out"' EXIT

run() {
  name=$1
  shift
  printf '  %-36s ... ' "$name"
  if "$@" >"$out" 2>&1; then
    echo ok
  else
    echo FAILED
    cat "$out"
    exit 1
  fi
}

echo "pre-push:"
# trha-recipe FFI 共享库路径（trha-llm 链接 libtrha_recipe_ffi.so）
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}:$(git rev-parse --show-toplevel)/3rdparty/trha-recipe/dist"
run "ternary verdict gate" sh scripts/check-ternary-verdict.sh
run "cabal test trha-test" cabal test trha-test
run "scheduler coverage" sh -c 'cd packages/scheduler && npm run --silent coverage'
echo "pre-push checks passed"
