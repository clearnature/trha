#!/bin/sh
# Slower gates that would make every commit painful.
# Installed by scripts/install-hooks.sh (root postinstall).
#
# Timings on a warm tree: cabal test trha-test ~135s, scheduler/desktop
# coverage ~15s total, web vitest ~1s. Full `cabal test all` (~6.5 min) and the
# full coverage report stay in CI.
set -e

cd "$(git rev-parse --show-toplevel)"

out=$(mktemp)
trap 'rm -f "$out"' EXIT

run() {
  name=$1
  shift
  printf '  %-36s ... ' "$name"
  if "$@" >"$out" 2>&1; then
    echo ok
  else
    echo FAILED
    cat "$out"
    exit 1
  fi
}

echo "pre-push:"
run "cabal test trha-test" cabal test trha-test
run "scheduler coverage" sh -c 'cd packages/scheduler && npm run --silent coverage'
run "web vitest" sh -c 'cd packages/app/Web && ./node_modules/.bin/vitest run'
run "desktop coverage" sh -c 'cd packages/app/Desktop && npm run --silent coverage'
echo "pre-push checks passed"
