#!/bin/sh
# 提交即推送。用 --no-verify：pre-push 的慢门禁（cabal test all）交给 CI，
# 本地只保证「已推送」这件事不被忘记。
# 立此规矩的原因（2026-10-31）：trha 目录两次被整体清空（连 .git 一起），
# 未推送的提交随之消失，只能按设计重写。
if git push --no-verify origin HEAD >/dev/null 2>&1; then
  echo "  [auto-push] ok"
else
  echo "  [auto-push] 失败，请手动 git push --no-verify"
fi
