#!/bin/sh
# Fast checks for the code touched by the staged changes.
# Installed by scripts/install-hooks.sh (root postinstall).
#
# Haskell: incremental `cabal build all` (~1s when nothing changed, but a
# fresh clone pays a full rebuild). Full `cabal test all` takes ~6.5 minutes
# and belongs to CI / pre-push, not here.
set -e

cd "$(git rev-parse --show-toplevel)"

changed=$(git diff --cached --name-only)
if [ -z "$changed" ]; then
  echo "check: nothing staged, skipping"
  exit 0
fi

need_scheduler=0
need_web=0
need_desktop=0
need_haskell=0
need_lint=0
lint_files=$(printf '%s\n' "$changed" | grep -E '\.(ts|tsx|mts|cts|js|mjs)$' || true)
if [ -n "$lint_files" ]; then need_lint=1; fi
need_hlint=0
# vendored third-party Haskell under 3rdparty/ keeps upstream style; lint gate applies to project sources only
haskell_sources=$(printf '%s\n' "$changed" | grep -E '\.(hs|lhs)$' | grep -v '^3rdparty/' || true)
if [ -n "$haskell_sources" ]; then need_hlint=1; fi
need_ci=0
case "$changed" in
  *.github/workflows/*) need_ci=1 ;;
esac
case "$changed" in
  *package.json*) need_ci=1 ;;
esac
need_docs=0
md_changed=$(printf '%s\n' "$changed" | grep -E '\.md$' || true)
if [ -n "$md_changed" ]; then need_docs=1; fi

# Shared config affects every TypeScript project.
case "$changed" in
  *tsconfig.base.json*|*package.json*|*package-lock.json*)
    need_scheduler=1; need_web=1; need_desktop=1
    ;;
esac

case "$changed" in *packages/scheduler/*) need_scheduler=1 ;; esac
case "$changed" in *packages/app/Web/*) need_web=1 ;; esac
case "$changed" in *packages/app/Desktop/*) need_desktop=1 ;; esac
haskell_changed=$(printf '%s\n' "$changed" | grep -E '\.(hs|lhs|cabal)$|^cabal\.project$' || true)
if [ -n "$haskell_changed" ]; then need_haskell=1; fi

check_ts() {
  dir=$1
  script=$2
  printf '  %-28s %s ... ' "$dir" "$script"
  if (cd "$dir" && npm run --silent "$script" >/dev/null 2>&1); then
    echo ok
  else
    echo FAILED
    (cd "$dir" && npm run --silent "$script")
    exit 1
  fi
}

check_haskell() {
  printf '  %-28s %s ... ' "haskell" "cabal build all"
  if cabal build all >/dev/null 2>&1; then
    echo ok
  else
    echo FAILED
    cabal build all
    exit 1
  fi
  printf '  %-28s %s ... ' "haskell" "cabal check"
  if cabal check >/dev/null 2>&1; then
    echo ok
  else
    echo FAILED
    cabal check
    exit 1
  fi
}

check_lint() {
  printf '  %-28s %s ... ' "lint" "oxlint (staged)"
  # shellcheck disable=SC2086 # lint_files is a newline list without spaces
  if node scripts/run-oxlint.mjs $lint_files >/dev/null 2>&1; then
    echo ok
  else
    echo FAILED
    # shellcheck disable=SC2086
    node scripts/run-oxlint.mjs $lint_files
    exit 1
  fi
}

check_hlint() {
  if ! command -v hlint >/dev/null 2>&1; then
    printf '  %-28s %s\n' "hlint" "SKIPPED (apt install hlint)"
    return 0
  fi
  printf '  %-28s %s ... ' "hlint" "staged modules"
  # shellcheck disable=SC2086 # haskell_sources is a newline list without spaces
  if hlint $haskell_sources >/dev/null 2>&1; then
    echo ok
  else
    echo FAILED
    # shellcheck disable=SC2086
    hlint $haskell_sources
    exit 1
  fi
}

check_ci() {
  printf '  %-28s %s ... ' "ci workflows" "script refs"
  if node scripts/verify-ci-workflows.mjs --quiet >/dev/null 2>&1; then
    echo ok
  else
    echo FAILED
    node scripts/verify-ci-workflows.mjs
    exit 1
  fi
}

check_docs() {
  printf '  %-28s %s ... ' "docs" "local links"
  if node scripts/verify-doc-links.mjs --quiet >/dev/null 2>&1; then
    echo ok
  else
    echo FAILED
    node scripts/verify-doc-links.mjs
    exit 1
  fi
}

if [ "$need_scheduler" = 0 ] && [ "$need_web" = 0 ] && [ "$need_desktop" = 0 ] \
  && [ "$need_haskell" = 0 ] && [ "$need_lint" = 0 ] && [ "$need_hlint" = 0 ] \
  && [ "$need_ci" = 0 ] && [ "$need_docs" = 0 ]; then
  echo "check: nothing type-checked by this hook, skipping"
  exit 0
fi

echo "check:"
if [ "$need_haskell" = 1 ]; then check_haskell; fi
if [ "$need_hlint" = 1 ]; then check_hlint; fi
if [ "$need_ci" = 1 ]; then check_ci; fi
if [ "$need_docs" = 1 ]; then check_docs; fi
if [ "$need_lint" = 1 ]; then check_lint; fi
if [ "$need_scheduler" = 1 ]; then check_ts packages/scheduler typecheck; fi
if [ "$need_web" = 1 ]; then check_ts packages/app/Web typecheck; fi
if [ "$need_desktop" = 1 ]; then
  check_ts packages/app/Desktop typecheck
  check_ts packages/app/Desktop "typecheck:main"
fi
echo "all checks passed"
