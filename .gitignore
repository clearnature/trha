# 测试用模型 checkpoint（242 MB，不入库；源头在 /data/trit/pyBitNet/scripts/artifacts/sov_native/）
models/

# Reasonix 会话运行时产物（task 状态快照、topic 元数据）——每次会话都变，不入库。
# 曾由 8c48c75「纳入跟踪（迁移前快照）」的 git add -A 误入库 2167 个文件。
.reasonix/

# Electron 打包产物与 TS 编译输出 —— 同一次 git add -A 误入库（308 个文件、约 610 MB）。
# 真源在 packages/app/Desktop/src 与 packages/scheduler/src，这里是它们的构建结果。
# 注：benchmarks/coverage/ 与 benchmarks/results/ 已由上面的 coverage/ 与
# benchmarks/results/ 规则覆盖，只是当时"先入库再 ignore"，故一并从索引移除。
packages/app/Desktop/release/
packages/app/Desktop/resources/node-runtime/
packages/app/Desktop/resources/scheduler-dist/

# studio 静态页面的**输出目录**：由 packages/app/Desktop/package.json 的
# export:studio 脚本生成（vite build && rm -rf .../studio-public/* &&
# cp -r dist/renderer/* .../studio-public/）。scheduler/src/Server 只在运行时
# 把它当静态托管目录读取，不是源码。同 8c48c75 误入库。
packages/scheduler/studio-public/

# ── 防御性规则：兜住构建/打包产物，避免重犯 ca800d7/b65618c/d28c069 那类误入库 ──
# Electron / electron-builder 的散落产物（产物目录本身已按路径忽略，这里兜底）
*.deb
*.rpm
*.AppImage
*.snap
*.dmg
*.asar
# TypeScript / Vite 增量编译产物
*.tsbuildinfo
.vite/
# 通用构建输出目录（dist 是构建约定；各子包另有显式规则）
dist/
cabal.project.local
# Python 字节码缓存
__pycache__/
*.pyc

# Local end-to-end scratch (state dirs, step captures, logs)
.e2e-*/

# Mimosa security-scan hook state (per-directory, machine-local)
.mimosa/
