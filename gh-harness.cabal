cabal-version:      3.0
name:               gh-harness
version:            0.1.0.0
synopsis:           A microkernel agent harness written in Haskell
license:            MIT
author:             Yanli
build-type:         Simple

-- Core Engine (Haskell/GHC)
library gh-harness-core
  exposed-modules:  
    Core.Plugin.Free
    Core.Plugin.Types
    Core.Session.Types
    Core.Session.Manager
    Core.Agent.Types
    Core.Agent.StateMachine
    Core.Tools.Registry
    Core.Tools.Types
    Core.Event.Bus
    Core.Event.Types
    Core.Cache.Engine
    Core.Cache.Types
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , free
                  , containers
                  , stm
                  , text
                  , bytestring
                  , hashable
                  , aeson
  default-language: Haskell2010

-- LLM Adapters
library gh-harness-llm
  exposed-modules:  
    LLM.Adapter.Types
    LLM.Adapter.Interface
    LLM.Providers.DeepSeek
    LLM.Providers.OpenAI
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , gh-harness-core
                  , text
                  , aeson
                  , http-client
                  , containers
  default-language: Haskell2010

-- Infrastructure Layer
library gh-harness-infra
  exposed-modules:  
    Infrastructure.Storage.JSON
    Infrastructure.Storage.SQLite
    Infrastructure.Network.HTTP
    Infrastructure.Sandbox.Process
    Infrastructure.Telemetry.Metrics
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , gh-harness-core
                  , text
                  , aeson
                  , directory
                  , process
                  , bytestring
                  , containers
                  , http-client
                  , http-client-tls
                  , http-types
  default-language: Haskell2010

-- Orchestration Layer (TypeScript bridge)
library gh-harness-orchestration
  exposed-modules:  
    Orchestration.Bridge.Types
    Orchestration.Bridge.HTTP
    Orchestration.Parallel.Types
    Orchestration.Parallel.Scheduler
    Orchestration.Subagent.Types
    Orchestration.Subagent.Manager
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , gh-harness-core
                  , gh-harness-infra
                  , text
                  , aeson
                  , servant
                  , servant-server
                  , warp
                  , containers
                  , stm
                  , async
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
  default-language: Haskell2010

-- CLI Application
executable gh-harness-cli
  main-is:          Main.hs
  hs-source-dirs:   packages/app/CLI
  ghc-options:      -rtsopts
  build-depends:    base ^>=4.22
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
                  , directory
                  , filepath
                  , ansi-terminal
  default-language: Haskell2010

-- Test Suite
test-suite gh-harness-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base ^>=4.22
                  , gh-harness-core
                  , gh-harness-llm
                  , gh-harness-infra
                  , hspec
                  , QuickCheck
                  , text
                  , stm
                  , containers
                  , free
                  , bytestring
                  , hashable
  ghc-options:      -rtsopts
  default-language: Haskell2010