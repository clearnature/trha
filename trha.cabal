-- API Server (OpenAI/Anthropic/Responses protocols)
-- visibility: public so the standalone CLI package (packages/app/CLI) can
-- depend on it via `trha:trha-api`.
library trha-api
  visibility:        public
  exposed-modules:
    API.Server
    API.Providers
    API.ProviderProbe
    API.ProviderRuntime
    Core.Provider.Types

  --------------------------------------------------------------------------
  -- ⚠️⚠️  禁 止 删 除 本 节 —— 下面 27 项是【必需】的，不是冗余  ⚠️⚠️
  --------------------------------------------------------------------------
  --
  -- 为什么必须列在这里：
  -- 本库与 trha-llm **共享 `hs-source-dirs: src`**。GHC 带 `-isrc` 时会在同一目录找到这些
  -- 源文件，并把它们当成本库要引用的模块。若不在 other-modules 里列出，cabal 就**不编译**
  -- 它们 —— 于是「引用了却没人编」，并且失败发生在**链接期**（不是编译期），极易被误判成
  -- "冗余项，可以删掉优化"。
  --
  -- 实测证据（2026-09-13，本仓）：
  -- 删掉本节后：
  -- cabal build trha-api  → EXIT=0        ★ 单库构建**骗过了**，看不出问题
  -- cabal build all       → EXIT=1，链接器报
  -- undefined reference to
  -- `...inplacezmtrhazmapi_LLMziProvidersziDeepSeek_parseDeepSeekChatTurn_closure`
  -- （符号前缀 `...trhazmapi_` 表明 trha-api 在找 DeepSeek，但没人编译它）
  -- cabal build trha-api 的产物此时只剩 4 个 .o（API/*），Infrastructure.*/LLM.*/Core.* 全消失
  -- 随后已完整回滚（`git diff` 为空，四个套件全绿）。请不要重蹈：**先看本注释再动**。
  --
  -- 【已评估：决定 **不** 拆分（2026-09-13，用户裁定，见 commit 记录）】
  -- 曾提议"拆分 `hs-source-dirs`"（把 `src/` 按库拆开，本节随之消失）。**已撤回**，理由：
  --   ① 提出它的理由是"消除重复编译" —— 但那影响的是**构建时间**，而本项目的判据是
  --      **数学/理论正确性**，构建时间**不是判据**（用户 2026-09-13 明确纠正过这一取向）；
  --   ② 唯一可能算实质的理由是"trha-api 与 trha-llm 的 LLMAdapter 是两个不同类型"，
  --      但**尚未验证**它是否仍阻碍任何该做的事 —— 要动架构，应先写注入测试证明真有障碍；
  --   ③ 动它需要挪源文件（含 `src/Core/Provider/Types.hs`），而本轮已实测"动本节 ⇒ 链接失败"。
  -- 结论：**维持现状** —— 本节保持 27 项完整，**不再提议拆分**。
  --
  -- 分类（**仅**当将来有人拿出"真有障碍"的证据、坚持要拆时，用它做核对清单）：
  -- · 24 项 = trha-llm 的 exposed-modules：20 × `Infrastructure.CPU.*` + 4 × `LLM.*`
  -- ·  5 项 = trha-core 的 exposed-modules：`Core.Agent.Modes` / `Core.Agent.StateMachine`
  -- / `Core.Agent.Types` / `Core.Session.Manager` / `Core.Session.Types`
  --   （后两项 StateMachine/Types 是 D-3 接内核 FSM 后新增的 —— 会话层依赖它们）
  -- ⚠️ 注意 `build-depends` 里**已经**列了 `trha:trha-core` 与 `trha:trha-llm` ——
  -- 所以这不是"依赖没写"，而是"共享 src/ 导致的被迫重编"。两者不是一回事。
  -- ⚠️ 若将来把 `src/` 拆开，本节应随之**大幅缩短**（甚至清空）；届时用这 27 项做核对清单。
  --
  other-modules:
    Core.Agent.Modes
    Core.Agent.StateMachine
    Core.Agent.Types
    Core.Session.Manager
    Core.Session.Types
    Infrastructure.CPU.ConstraintVerdict
    Infrastructure.CPU.HolographicSpace
    Infrastructure.CPU.S2Geometry
    Infrastructure.CPU.GF3Ops
    Infrastructure.CPU.Christoffel
    Infrastructure.CPU.GF3Intrinsic
    Infrastructure.CPU.SovereignIntrinsic
    Infrastructure.CPU.SovereignModel
    Infrastructure.CPU.SovereignPhase12
    Infrastructure.CPU.SovereignGF27
    Infrastructure.CPU.SovereignLossGain
    Infrastructure.CPU.SovereignSection
    Infrastructure.CPU.SovereignTypes
    Infrastructure.CPU.SovereignWuxingLayer
    Infrastructure.CPU.Z12Sys
    Infrastructure.CPU.BLAS
    Infrastructure.CPU.Inference
    Infrastructure.CPU.Ops
    Infrastructure.CPU.SIMD
    Infrastructure.CPU.Types
    LLM.Adapter.Interface
    LLM.Adapter.Types
    LLM.Providers.DeepSeek
    LLM.Stream
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , trha:trha-llm
                  , servant
                  , servant-server
                  , tagged
                  , warp
                  , wai
                  , aeson
                  , text
                  , bytestring
                  , stm
                  , containers
                  , http-types
                  , http-client
                  , http-client-tls
                  , vector
                  , async
                  , directory
                  , filepath
  default-language: Haskell2010

-- Infrastructure Layer
library trha-infra
  exposed-modules:  
    Infrastructure.Storage.JSON
    Infrastructure.Storage.SQLite
    Infrastructure.Network.HTTP
    Infrastructure.Sandbox.Process
    Infrastructure.Telemetry.Metrics
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , text
                  , aeson
                  , directory
                  , process
                  , bytestring
                  , containers
                  , http-client
                  , http-client-tls
                  , http-types
  default-language: Haskell2010

-- WebGPU backend —— 真实绑定 wgpu-native 的 C API
-- 计划与进度：docs/plans/webgpu-wiring-plan.md
-- 外部库落在 3rdparty/wgpu-native/（**不在仓库外引用**）。
-- 阶段说明：W2 阶段只有强类型句柄层 + 枚举（值经 hsc2hs 从真头文件求值），
-- 因此这里只用到 include-dirs（编译期）；W3 起再加
--   extra-libraries: wgpu_native
--   extra-lib-dirs:  3rdparty/wgpu-native/lib
library trha-webgpu
  exposed-modules:
    Infrastructure.WebGPU.Raw.Types
    Infrastructure.WebGPU.Raw.Enums
    Infrastructure.WebGPU.Raw.Structs
    Infrastructure.WebGPU.Raw.FFI
    Infrastructure.WebGPU.Raw.Async
    Infrastructure.WebGPU.Context
    Infrastructure.WebGPU.Buffer
    Infrastructure.WebGPU.Kernel
    Infrastructure.WebGPU.Error
  hs-source-dirs:   src
  include-dirs:     3rdparty/wgpu-native/include
  c-sources:        cbits/wgpu_callback_shim.c
  extra-libraries:         wgpu_native
  -- 库目录用 extra-lib-dirs-static（Cabal 规范 3.8+：接受相对路径，适合仓库内 3rdparty/）。
  -- 运行时查找 .so 由 LD_LIBRARY_PATH 或 rpath 负责，见 webgpu-wiring-plan.md 的 W4/W6。
  extra-lib-dirs-static:   3rdparty/wgpu-native/lib

  build-depends:    base ^>=4.22
  default-language: Haskell2010

-- WebGPU 真机探针 / hello-compute（W6）
executable trha-webgpu-hello
  main-is:          HelloCompute.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- WebGPU hello-compute（W6 阶段二：完整 dispatch + 读回对拍）
executable trha-webgpu-compute
  main-is:          Compute.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- WebGPU 错误捕获探针（验证 uncaptured error 已被接管）
executable trha-webgpu-errorprobe
  main-is:          ErrorProbe.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- GF(27) 乘法 kernel 的 GPU↔CPU 对拍
executable trha-webgpu-gf27
  main-is:          Gf27Probe.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
                  , trha:trha-llm
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- GF(27) 矩阵乘 kernel（含 GPU/CPU 实测计时）
executable trha-webgpu-gf27matmul
  main-is:          Gf27Matmul.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
                  , trha:trha-llm
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- WebGPU 真机测试（独立套件：无 GPU 时 pending，不拖累主套件）
test-suite trha-webgpu-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test-webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
                  , trha:trha-llm
                  , hspec
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- GF(27) 行点积 AVX2 的对拍与基准
executable trha-cpu-gf27simd
  main-is:          Gf27SimdProbe.hs
  hs-source-dirs:   benchmarks/cpu
  build-depends:    base ^>=4.22
                  , trha:trha-llm
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- CPU 侧数学正确性套件（判据 C1：代数结构 ↔ 权威规范）
test-suite trha-cpu-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test-cpu
  build-depends:    base ^>=4.22
                  , trha:trha-llm
                  , hspec
                  , process
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- CLI Application
executable trha
  main-is:          Main.hs
  hs-source-dirs:   packages/app/CLI
  -- 注：本可执行的 hs-source-dirs 是 `packages/app/CLI`，**独立目录**，与其它库无共享，
  -- 故下面 20 项是它自己的真文件，属**正常**。这与 library trha-api 那 27 项
  -- （共享 `src/` 被迫重编）**性质不同**，不要互相对照或"清理"。
  other-modules:
    Bridge.Scheduler
    Config.Settings
    UI.Commands.Registry
    Core.HTTP
    Core.Transcript
    Core.SessionSummary
    Core.Replay
    Core.SSE
    Core.Types
    UI.Brick
    UI.Commands
    UI.I18n
    UI.SettingsView
    UI.StatsView
    UI.StatusInfo
    UI.Render.Markdown
    UI.Render.Picker
    UI.Render.ToolCard
    UI.Theme
    UI.Render.Footer
  ghc-options:      -rtsopts -threaded
  build-depends:    base ^>=4.22
                  , trha:trha-api
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
                  , directory
                  , filepath
                  , ansi-terminal
                  , process
                  , brick >= 2.1
                  , vty >= 6.1
                  , vty-crossplatform >= 0.4
                  , optparse-applicative >= 0.18
                  , stm
                  , containers
                  , async
                  , time
                  , haskeline >= 0.8
                  , yaml
                  , unix
  default-language: Haskell2010

-- Test Suite
test-suite trha-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base ^>=4.22
                  , directory
                  , trha:trha-core
                  , trha:trha-llm
                  , trha:trha-infra
                  , trha:trha-api
                  , hspec
                  , QuickCheck
                  , vector
                  , text
                  , stm
                  , containers
                  , free
                  , bytestring
                  , hashable
                  , aeson
                  -- HTTP 端到端装配测试：起真实 server + 发真实请求
                  , warp
                  , wai
                  , http-types
                  , http-client
  -- -threaded 是必需的：warp 的 testWithApplication 要把 server 跑在另一个
  -- capability 上，非 threaded RTS 下请求会以 NoResponseDataReceived 失败。
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- Kernel stub server (K6): deterministic two-round tool loop for
-- end-to-end development without a DeepSeek API key.
executable trha-kernel-stub
  main-is:          StubKernel.hs
  hs-source-dirs:   packages/kernel-stub
  build-depends:    base ^>=4.22
                  , trha:trha-api
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010
