cabal-version:      3.8
name:               trha
version:            0.1.0.0
synopsis:           A microkernel agent harness written in Haskell
license:            MIT
author:             Yanli
build-type:         Simple

-- Core Engine (Haskell/GHC)
library trha-core
  exposed-modules:  
    Core.Plugin.Free
    Core.Plugin.Types
    Core.Session.Types
    Core.Session.Manager
    Core.Agent.Types
    Core.Agent.Modes
    Core.Agent.StateMachine
    Core.Tools.Registry
    Core.Tools.Types
    Core.Event.Bus
    Core.Event.Types
    Core.Cache.Engine
    Core.Cache.Types
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , free
                  , containers
                  , stm
                  , text
                  , bytestring
                  , hashable
                  , aeson
  default-language: Haskell2010

-- LLM Adapters + CPU Backend (merged to avoid GHC 9.14 internal-lib linking bug)
library trha-llm
  exposed-modules:  
    LLM.Adapter.Types
    LLM.Adapter.Interface
    LLM.Providers.DeepSeek
    LLM.Providers.OpenAI
    LLM.Stream
    Infrastructure.CPU.Types
    Infrastructure.CPU.SIMD
    Infrastructure.CPU.BLAS
    Infrastructure.CPU.Ops
    Infrastructure.CPU.Quant
    Infrastructure.CPU.SOV3
    Infrastructure.CPU.S2Geometry
    Infrastructure.CPU.GF3Ops
    Infrastructure.CPU.Christoffel
    Infrastructure.CPU.SovereignModel
    Infrastructure.CPU.GF27SIMD
    Infrastructure.CPU.HoloPi
    Infrastructure.CPU.HolographicSpace
    Infrastructure.CPU.GF3Intrinsic
    Infrastructure.CPU.SovereignIntrinsic
    Infrastructure.CPU.SovereignGF27
    Infrastructure.CPU.SovereignSection
    Infrastructure.CPU.SovereignLossGain
    Infrastructure.CPU.Z12Sys
    Infrastructure.CPU.SovereignPhase12
    Infrastructure.CPU.SovereignWuXing
    Infrastructure.CPU.SovereignWuxingLayer
    Infrastructure.CPU.ConstraintVerdict
    Infrastructure.CPU.SovereignFull
    Infrastructure.CPU.SovereignPacked
    Infrastructure.CPU.SovereignTypes
    Infrastructure.CPU.Inference
    Infrastructure.CPU.GGUF
    Infrastructure.CPU.Dequant
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , trha:trha-infra
                  , text
                  , aeson
                  , http-client
                  , http-client-tls
                  , http-types
                  , containers
                  , bytestring
                  , vector
                  , stm
                  , network
  default-language: Haskell2010
  c-sources:        cbits/gf27_avx2.c

-- API Server (OpenAI/Anthropic/Responses protocols)
-- visibility: public so the standalone CLI package (packages/app/CLI) can
-- depend on it via `trha:trha-api`.
library trha-api
  visibility:        public
  exposed-modules:
    API.Server
    API.Providers
    API.ProviderProbe
    API.ProviderRuntime
    Core.Provider.Types
  other-modules:
    Core.Agent.Modes
    Core.Session.Manager
    Core.Session.Types
    Infrastructure.CPU.ConstraintVerdict
    Infrastructure.CPU.HolographicSpace
    Infrastructure.CPU.S2Geometry
    Infrastructure.CPU.GF3Ops
    Infrastructure.CPU.Christoffel
    Infrastructure.CPU.GF3Intrinsic
    Infrastructure.CPU.SovereignIntrinsic
    Infrastructure.CPU.SovereignModel
    Infrastructure.CPU.SovereignPhase12
    Infrastructure.CPU.SovereignGF27
    Infrastructure.CPU.SovereignLossGain
    Infrastructure.CPU.SovereignSection
    Infrastructure.CPU.SovereignTypes
    Infrastructure.CPU.SovereignWuxingLayer
    Infrastructure.CPU.Z12Sys
    Infrastructure.CPU.BLAS
    Infrastructure.CPU.Inference
    Infrastructure.CPU.Ops
    Infrastructure.CPU.SIMD
    Infrastructure.CPU.Types
    LLM.Adapter.Interface
    LLM.Adapter.Types
    LLM.Providers.DeepSeek
    LLM.Stream
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , trha:trha-llm
                  , servant
                  , servant-server
                  , tagged
                  , warp
                  , wai
                  , aeson
                  , text
                  , bytestring
                  , stm
                  , containers
                  , http-types
                  , http-client
                  , http-client-tls
                  , vector
                  , async
                  , directory
                  , filepath
  default-language: Haskell2010

-- Infrastructure Layer
library trha-infra
  exposed-modules:  
    Infrastructure.Storage.JSON
    Infrastructure.Storage.SQLite
    Infrastructure.Network.HTTP
    Infrastructure.Sandbox.Process
    Infrastructure.Telemetry.Metrics
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , text
                  , aeson
                  , directory
                  , process
                  , bytestring
                  , containers
                  , http-client
                  , http-client-tls
                  , http-types
  default-language: Haskell2010

-- WebGPU backend —— 真实绑定 wgpu-native 的 C API
-- 计划与进度：docs/plans/webgpu-wiring-plan.md
-- 外部库落在 3rdparty/wgpu-native/（**不在仓库外引用**）。
-- 阶段说明：W2 阶段只有强类型句柄层 + 枚举（值经 hsc2hs 从真头文件求值），
-- 因此这里只用到 include-dirs（编译期）；W3 起再加
--   extra-libraries: wgpu_native
--   extra-lib-dirs:  3rdparty/wgpu-native/lib
library trha-webgpu
  exposed-modules:
    Infrastructure.WebGPU.Raw.Types
    Infrastructure.WebGPU.Raw.Enums
    Infrastructure.WebGPU.Raw.Structs
    Infrastructure.WebGPU.Raw.FFI
    Infrastructure.WebGPU.Raw.Async
    Infrastructure.WebGPU.Context
    Infrastructure.WebGPU.Buffer
    Infrastructure.WebGPU.Kernel
    Infrastructure.WebGPU.Error
  hs-source-dirs:   src
  include-dirs:     3rdparty/wgpu-native/include
  c-sources:        cbits/wgpu_callback_shim.c
  extra-libraries:         wgpu_native
  -- 库目录用 extra-lib-dirs-static（Cabal 规范 3.8+：接受相对路径，适合仓库内 3rdparty/）。
  -- 运行时查找 .so 由 LD_LIBRARY_PATH 或 rpath 负责，见 webgpu-wiring-plan.md 的 W4/W6。
  extra-lib-dirs-static:   3rdparty/wgpu-native/lib

  build-depends:    base ^>=4.22
  default-language: Haskell2010

-- WebGPU 真机探针 / hello-compute（W6）
executable trha-webgpu-hello
  main-is:          HelloCompute.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- WebGPU hello-compute（W6 阶段二：完整 dispatch + 读回对拍）
executable trha-webgpu-compute
  main-is:          Compute.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- WebGPU 错误捕获探针（验证 uncaptured error 已被接管）
executable trha-webgpu-errorprobe
  main-is:          ErrorProbe.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- GF(27) 乘法 kernel 的 GPU↔CPU 对拍
executable trha-webgpu-gf27
  main-is:          Gf27Probe.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
                  , trha:trha-llm
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- GF(27) 矩阵乘 kernel（含 GPU/CPU 实测计时）
executable trha-webgpu-gf27matmul
  main-is:          Gf27Matmul.hs
  hs-source-dirs:   benchmarks/webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
                  , trha:trha-llm
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- WebGPU 真机测试（独立套件：无 GPU 时 pending，不拖累主套件）
test-suite trha-webgpu-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test-webgpu
  build-depends:    base ^>=4.22
                  , trha:trha-webgpu
                  , trha:trha-llm
                  , hspec
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- GF(27) 行点积 AVX2 的对拍与基准
executable trha-cpu-gf27simd
  main-is:          Gf27SimdProbe.hs
  hs-source-dirs:   benchmarks/cpu
  build-depends:    base ^>=4.22
                  , trha:trha-llm
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- CPU 侧数学正确性套件（判据 C1：代数结构 ↔ 权威规范）
test-suite trha-cpu-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test-cpu
  build-depends:    base ^>=4.22
                  , trha:trha-llm
                  , hspec
                  , process
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- CLI Application
executable trha
  main-is:          Main.hs
  hs-source-dirs:   packages/app/CLI
  other-modules:
    Bridge.Scheduler
    Config.Settings
    UI.Commands.Registry
    Core.HTTP
    Core.Transcript
    Core.SessionSummary
    Core.Replay
    Core.SSE
    Core.Types
    UI.Brick
    UI.Commands
    UI.I18n
    UI.SettingsView
    UI.StatsView
    UI.StatusInfo
    UI.Render.Markdown
    UI.Render.Picker
    UI.Render.ToolCard
    UI.Theme
    UI.Render.Footer
  ghc-options:      -rtsopts -threaded
  build-depends:    base ^>=4.22
                  , trha:trha-api
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , http-types
                  , directory
                  , filepath
                  , ansi-terminal
                  , process
                  , brick >= 2.1
                  , vty >= 6.1
                  , vty-crossplatform >= 0.4
                  , optparse-applicative >= 0.18
                  , stm
                  , containers
                  , async
                  , time
                  , haskeline >= 0.8
                  , yaml
                  , unix
  default-language: Haskell2010

-- Test Suite
test-suite trha-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base ^>=4.22
                  , directory
                  , trha:trha-core
                  , trha:trha-llm
                  , trha:trha-infra
                  , trha:trha-api
                  , hspec
                  , QuickCheck
                  , vector
                  , text
                  , stm
                  , containers
                  , free
                  , bytestring
                  , hashable
                  , aeson
                  -- HTTP 端到端装配测试：起真实 server + 发真实请求
                  , warp
                  , wai
                  , http-types
                  , http-client
  -- -threaded 是必需的：warp 的 testWithApplication 要把 server 跑在另一个
  -- capability 上，非 threaded RTS 下请求会以 NoResponseDataReceived 失败。
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- Kernel stub server (K6): deterministic two-round tool loop for
-- end-to-end development without a DeepSeek API key.
executable trha-kernel-stub
  main-is:          StubKernel.hs
  hs-source-dirs:   packages/kernel-stub
  build-depends:    base ^>=4.22
                  , trha:trha-api
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010
