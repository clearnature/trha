cabal-version:      3.8
name:               trha
version:            0.1.0.0
synopsis:           A microkernel agent harness written in Haskell
license:            MIT
author:             Yanli
build-type:         Simple

-- Core Engine (Haskell/GHC)
library trha-core
  exposed-modules:
    Sov.Types
    Sov.GF3Ops
    Sov.Section
    Sov.Z12Sys
    Sov.LossGain
    Sov.Phase12
    Sov.S2Geometry
    Sov.HoloPi
    Sov.WuXing
    Sov.HolographicSpace
    Sov.Christoffel
    Sov.GF3Intrinsic
    Sov.GF27
    Sov.Model
    Sov.WuxingLayer
    Sov.Intrinsic
    Sov.ConstraintVerdict
    Core.Session.Types
    Core.Session.Projection
    Core.Session.Manager
    Core.Agent.Types
    Core.Agent.Modes
    Core.Agent.StateMachine
    Core.Tools.Registry
    Core.Tools.Types
    Core.Event.Bus
    Core.Event.Types
    Core.Cache.Engine
    Core.Cache.Types
    -- 内核载体：C[A₄] 函数空间 + Plancherel 内积（数学实现在 sov-math）
    Kernel.Carrier
  hs-source-dirs:   src/core
  build-depends:    base ^>=4.22
                  , sov-math
                  , free
                  , containers
                  , stm
                  , text
                  , bytestring
                  , hashable
                  , aeson
                  , vector
  default-language: Haskell2010

-- LLM Adapters + CPU Backend (merged to avoid GHC 9.14 internal-lib linking bug)
library trha-llm
  exposed-modules:  
    LLM.Adapter.Types
    LLM.Adapter.Interface
    LLM.Providers.DeepSeek
    LLM.Providers.OpenAI
    LLM.Stream
  hs-source-dirs:   src/llm
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , trha:trha-infra
                  , text
                  , aeson
                  , http-client
                  , http-client-tls
                  , http-types
                  , containers
                  , bytestring
                  , vector
                  , stm
                  , network
  default-language: Haskell2010
  c-sources:        src/llm/cbits/gf27_avx2.c
  cc-options:       -O2 -fopenmp
  ld-options:       -fopenmp

-- API Server (OpenAI/Anthropic/Responses protocols)
-- visibility: public so the standalone CLI package (packages/app/CLI) can
-- depend on it via `trha:trha-api`.
library trha-api
  visibility:        public
  exposed-modules:
    API.Server
    API.Security
    API.Providers
    API.ProviderProbe
    API.ProviderRuntime
    Core.Provider.Types

  -- 2026-10-27：按库拆分后本库只看 src/api，44 项 other-modules 已删除。
  -- 类型唯一性回归见 docs/plans/improvement-plan-2026-10-27.md P-01。
  hs-source-dirs:   src/api
  extra-libraries:         wgpu_native
  -- Windows 用 GNU/MinGW 构建（libwgpu_native.dll.a + wgpu_native.dll）；
  -- 必须用 extra-lib-dirs-static：ghc-pkg 拒绝注册含相对路径的 library-dirs。
  -- 该目录里的 libwgpu_native.dll.a（import lib）会被 -lwgpu_native 命中。
  if os(windows)
    extra-lib-dirs-static: 3rdparty/wgpu-native/lib/windows
  else
    extra-lib-dirs-static: 3rdparty/wgpu-native/lib
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , trha:trha-llm
                  , trha:trha-infra
                  , trha:trha-webgpu
                  , servant
                  , servant-server
                  , tagged
                  , warp
                  , wai
                  , aeson
                  , text
                  , bytestring
                  , stm
                  , containers
                  , http-types
                  , http-client
                  , http-client-tls
                  , case-insensitive
                  , vector
                  , async
                  , directory
                  , filepath
                  , random
  if !os(windows)
    build-depends: unix
  default-language: Haskell2010

-- Infrastructure Layer
-- Infrastructure（存储/网络/沙箱）
-- visibility: public so the standalone CLI package (packages/app/CLI) can
-- depend on it via `trha:trha-infra` for `trha sandbox`.
library trha-infra
  visibility:        public
  exposed-modules:  
    Core.HTTPProxy
    Infrastructure.Storage.JSON
    Infrastructure.Storage.SessionStore
    Infrastructure.Storage.SQLite
    Infrastructure.Network.HTTP
    Infrastructure.Sandbox
    Infrastructure.Sandbox.Policy
    Infrastructure.Sandbox.Scope
    Infrastructure.Sandbox.Plan
    Infrastructure.Sandbox.Backend
    Infrastructure.Sandbox.Error
    Infrastructure.Sandbox.Backend.Stub
    Infrastructure.Sandbox.Backend.Linux
    Infrastructure.Sandbox.Backend.Mac
    Infrastructure.Sandbox.Backend.Windows
    Infrastructure.Sandbox.Backend.FreeBSD
    Infrastructure.Sandbox.Backend.OpenBSD
    Infrastructure.Sandbox.Win32.Sid
    Infrastructure.Sandbox.Win32.Token
    Infrastructure.Sandbox.Win32.Acl
    Infrastructure.Sandbox.Win32.Job
    Infrastructure.Sandbox.Win32.Process
    Infrastructure.Sandbox.Win32.AppContainer
    Infrastructure.Sandbox.Win32.Path
    Infrastructure.Sandbox.Protocol
    Infrastructure.Sandbox.Runner
    Infrastructure.Sandbox.Config
    Infrastructure.Sandbox.Probe
    Infrastructure.Sandbox.Audit
    Infrastructure.Sandbox.Experiment
    Infrastructure.Sandbox.Process
    Infrastructure.Sandbox.Cgroup
    Infrastructure.Sandbox.Landlock
    Infrastructure.Telemetry.Metrics
  hs-source-dirs:   src/infra
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , cryptonite
                  , memory
                  , text
                  , aeson
                  , directory
                  , filepath
                  , process
                  , bytestring
                  , containers
                  , http-client
                  , http-client-tls
                  , http-types
                  , yaml
                  , time
  if !os(windows)
    build-depends: unix
  default-language: Haskell2010

-- WebGPU backend —— 真实绑定 wgpu-native 的 C API
-- 计划与进度：docs/plans/webgpu-wiring-plan.md
-- 外部库落在 3rdparty/wgpu-native/（**不在仓库外引用**）。
-- 阶段说明：W2 阶段只有强类型句柄层 + 枚举（值经 hsc2hs 从真头文件求值），
-- 因此这里只用到 include-dirs（编译期）；W3 起再加
--   extra-libraries: wgpu_native
--   extra-lib-dirs:  3rdparty/wgpu-native/lib
library trha-webgpu
  exposed-modules:
    Infrastructure.WebGPU.Raw.Types
    Infrastructure.WebGPU.Raw.Enums
    Infrastructure.WebGPU.Raw.Structs
    Infrastructure.WebGPU.Raw.FFI
    Infrastructure.WebGPU.Raw.Async
    Infrastructure.WebGPU.Context
    Infrastructure.WebGPU.Buffer
    Infrastructure.WebGPU.Kernel
    Infrastructure.WebGPU.Error
  hs-source-dirs:   src/webgpu
  include-dirs:     3rdparty/wgpu-native/include
  c-sources:        src/webgpu/cbits/wgpu_callback_shim.c
  extra-libraries:         wgpu_native
  -- 库目录用 extra-lib-dirs-static（Cabal 规范 3.8+：接受相对路径，适合仓库内 3rdparty/）。
  -- 运行时查找 .so 由 LD_LIBRARY_PATH 或 rpath 负责，见 webgpu-wiring-plan.md 的 W4/W6。
  if os(windows)
    extra-lib-dirs-static: 3rdparty/wgpu-native/lib/windows
  else
    extra-lib-dirs-static: 3rdparty/wgpu-native/lib
  build-depends:    base ^>=4.22
                  , text
                  , bytestring
                  , containers
                  , vector
  default-language: Haskell2010

-- CLI Application
executable trha
  main-is:          Main.hs
  hs-source-dirs:   packages/app/CLI
  -- 注：本可执行的 hs-source-dirs 是 `packages/app/CLI`，**独立目录**，与其它库无共享，
  -- 故下面 20 项是它自己的真文件，属**正常**。这与 library trha-api 那 27 项
  -- （共享 `src/` 被迫重编）**性质不同**，不要互相对照或"清理"。
  other-modules:
    Bridge.Scheduler
    Config.Settings
    Config.Home
    Core.Args
    UI.Commands.Registry
    Core.Bootstrap
    Core.HTTP
    Core.Transcript
    Core.Memory
    Core.PlanStore
    Core.ProjectStore
    Core.RunLog
    Core.RunState
    Core.StatePaths
    Core.SessionSummary
    Core.Replay
    Core.SSE
    Core.Clipboard
    Core.Currency
    Core.Export
    Core.Fonts
    Core.Fs
    Core.Sandbox
    Core.TurnStats
    Core.EffortContract
    Core.Types
    UI.Brick
    UI.Event
    UI.Commands
    UI.I18n
    UI.SettingsView
    UI.StatsView
    UI.StatusInfo
    UI.Render.Markdown
    UI.InputHistory
    UI.Dialog
    UI.Interaction
    UI.Layout
    UI.Completion
    UI.Keys
    UI.Skills
    UI.Selection
    UI.TimeStamp
    UI.State
    UI.Stash
    UI.Frecency
    UI.ModelPrefs
    UI.Render.Picker
    UI.Render.Sidebar
    UI.Render.Diff
    UI.Render.ToolCard
    UI.Render.ToolSummary
    UI.Render.Message
    UI.Theme
    UI.Setup
    UI.SetupWizard
    UI.IndexCache
    UI.CustomCommands
    UI.Render.Footer
    UI.TextWidth
    UI.ProviderPresets
  ghc-options:      -rtsopts -threaded
  build-depends:    base ^>=4.22
                  , trha:trha-api
                  , trha:trha-infra
                  , aeson
                  , text
                  , bytestring
                  , http-client
                  , http-client-tls
                  , connection
                  , http-types
                  , directory
                  , filepath
                  , ansi-terminal
                  , process
                  , brick >= 3.0
                  , microlens
                  , vty >= 6.1
                  , vty-crossplatform >= 0.4
                  , optparse-applicative >= 0.18
                  , stm
                  , containers
                  , async
                  , time
                  , haskeline >= 0.8
                  , yaml
  if !os(windows)
    build-depends: unix
  default-language: Haskell2010

-- Test Suite

test-suite trha-sandbox-test
  type:             exitcode-stdio-1.0
  main-is:          SandboxSpecMain.hs
  hs-source-dirs:   test-sandbox test
  other-modules:    SandboxSpec
                  , SandboxLinuxSpec
                  , SandboxMacSpec
                  , SandboxRunnerSpec
                  , SandboxCgroupSpec
                  , SandboxWindowsSpec
                  , SandboxBsdSpec
                  , SandboxLandlockSpec
                  , AuditSpec
                  , ExperimentSpec
                  , ConfigSpec
  build-depends:    base ^>=4.22
                  , directory
                  , filepath
                  , process
                  , hspec
                  , QuickCheck
                  , aeson
                  , bytestring
                  , text
                  , containers
                  , trha:trha-infra
  if !os(windows)
    build-depends: unix
  -- timeout-based runner tests need the threaded RTS (same reason as
  -- trha-test): without it the 200 ms deadline never fires.
  ghc-options:      -threaded
  default-language: Haskell2010

test-suite trha-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:    CoreContractSpec, SessionPersistSpec, ApprovalSpec, PlanSpec
                  , GoldenGF27Spec
                  , GoldenT6Spec
                  , DeepSeekCacheSpec
                  , StreamToolCallsSpec
                  , HTTPProxySpec
                  , WireGuardsSpec
                  , StreamTimeoutSpec
                  , SessionGateSpec
                  , ServerBindSpec
                  , SecuritySpec
                  , SessionTruthSpec
                  , SandboxSpec
                  , SandboxLinuxSpec
                  , SandboxRunnerSpec
                  , AuditSpec
                  , ExperimentSpec
                  , ConfigSpec
  hs-source-dirs:   test
  build-depends:    base ^>=4.22
                  , directory
                  , filepath
                  , process
                  , trha:trha-core
                  , sov-math
                  , trha:trha-llm
                  , trha:trha-infra
                  , trha:trha-api
                  , hspec
                  , QuickCheck
                  , vector
                  , text
                  , stm
                  , containers
                  , free
                  , bytestring
                  , hashable
                  , aeson
                  , scientific
                  -- HTTP 端到端装配测试：起真实 server + 发真实请求
                  , warp
                  , wai
                  , http-types
                  , http-client
  if !os(windows)
    build-depends: unix
  -- -threaded 是必需的：warp 的 testWithApplication 要把 server 跑在另一个
  -- capability 上，非 threaded RTS 下请求会以 NoResponseDataReceived 失败。
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010

-- Kernel stub server (K6): deterministic two-round tool loop for
-- end-to-end development without a DeepSeek API key.
executable trha-kernel-stub
  main-is:          StubKernel.hs
  hs-source-dirs:   packages/kernel-stub
  build-depends:    base ^>=4.22
                  , trha:trha-api
  ghc-options:      -rtsopts -threaded
  default-language: Haskell2010
