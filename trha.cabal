-- API Server (OpenAI/Anthropic/Responses protocols)
-- visibility: public so the standalone CLI package (packages/app/CLI) can
-- depend on it via `trha:trha-api`.
library trha-api
  visibility:        public
  exposed-modules:
    API.Server
    API.Providers
    API.ProviderProbe
    API.ProviderRuntime
    Core.Provider.Types

  --------------------------------------------------------------------------
  -- ⚠️⚠️  禁 止 删 除 本 节 —— 下面 27 项是【必需】的，不是冗余  ⚠️⚠️
  --------------------------------------------------------------------------
  --
  -- 为什么必须列在这里：
  -- 本库与 trha-llm **共享 `hs-source-dirs: src`**。GHC 带 `-isrc` 时会在同一目录找到这些
  -- 源文件，并把它们当成本库要引用的模块。若不在 other-modules 里列出，cabal 就**不编译**
  -- 它们 —— 于是「引用了却没人编」，并且失败发生在**链接期**（不是编译期），极易被误判成
  -- "冗余项，可以删掉优化"。
  --
  -- 实测证据（2026-09-13，本仓）：
  -- 删掉本节后：
  -- cabal build trha-api  → EXIT=0        ★ 单库构建**骗过了**，看不出问题
  -- cabal build all       → EXIT=1，链接器报
  -- undefined reference to
  -- `...inplacezmtrhazmapi_LLMziProvidersziDeepSeek_parseDeepSeekChatTurn_closure`
  -- （符号前缀 `...trhazmapi_` 表明 trha-api 在找 DeepSeek，但没人编译它）
  -- cabal build trha-api 的产物此时只剩 4 个 .o（API/*），Infrastructure.*/LLM.*/Core.* 全消失
  -- 随后已完整回滚（`git diff` 为空，四个套件全绿）。请不要重蹈：**先看本注释再动**。
  --
  -- 【已评估：决定 **不** 拆分（2026-09-13，用户裁定，见 commit 记录）】
  -- 曾提议"拆分 `hs-source-dirs`"（把 `src/` 按库拆开，本节随之消失）。**已撤回**，理由：
  --   ① 提出它的理由是"消除重复编译" —— 但那影响的是**构建时间**，而本项目的判据是
  --      **数学/理论正确性**，构建时间**不是判据**（用户 2026-09-13 明确纠正过这一取向）；
  --   ② 唯一可能算实质的理由是"trha-api 与 trha-llm 的 LLMAdapter 是两个不同类型"，
  --      但**尚未验证**它是否仍阻碍任何该做的事 —— 要动架构，应先写注入测试证明真有障碍；
  --   ③ 动它需要挪源文件（含 `src/Core/Provider/Types.hs`），而本轮已实测"动本节 ⇒ 链接失败"。
  -- 结论：**维持现状** —— 本节保持 27 项完整，**不再提议拆分**。
  --
  -- 分类（**仅**当将来有人拿出"真有障碍"的证据、坚持要拆时，用它做核对清单）：
  -- · 24 项 = trha-llm 的 exposed-modules：20 × `Infrastructure.CPU.*` + 4 × `LLM.*`
  -- ·  5 项 = trha-core 的 exposed-modules：`Core.Agent.Modes` / `Core.Agent.StateMachine`
  -- / `Core.Agent.Types` / `Core.Session.Manager` / `Core.Session.Types`
  --   （后两项 StateMachine/Types 是 D-3 接内核 FSM 后新增的 —— 会话层依赖它们）
  -- ⚠️ 注意 `build-depends` 里**已经**列了 `trha:trha-core` 与 `trha:trha-llm` ——
  -- 所以这不是"依赖没写"，而是"共享 src/ 导致的被迫重编"。两者不是一回事。
  -- ⚠️ 若将来把 `src/` 拆开，本节应随之**大幅缩短**（甚至清空）；届时用这 27 项做核对清单。
  --
  other-modules:
    Core.Agent.Modes
    Core.Agent.StateMachine
    Core.Agent.Types
    Core.Session.Manager
    Core.Session.Types
    Infrastructure.CPU.ConstraintVerdict
    Infrastructure.CPU.HolographicSpace
    Infrastructure.CPU.S2Geometry
    Infrastructure.CPU.GF3Ops
    Infrastructure.CPU.Christoffel
    Infrastructure.CPU.GF3Intrinsic
    Infrastructure.CPU.SovereignIntrinsic
    Infrastructure.CPU.SovereignModel
    Infrastructure.CPU.SovereignPhase12
    Infrastructure.CPU.SovereignGF27
    Infrastructure.CPU.SovereignLossGain
    Infrastructure.CPU.SovereignSection
    Infrastructure.CPU.SovereignTypes
    Infrastructure.CPU.SovereignWuxingLayer
    Infrastructure.CPU.Z12Sys
    Infrastructure.CPU.BLAS
    Infrastructure.CPU.Inference
    Infrastructure.CPU.SovereignFull
    Infrastructure.CPU.B1Window
    Infrastructure.CPU.GF27SIMD
    Infrastructure.CPU.Ops
    Infrastructure.CPU.SOV3
    Infrastructure.CPU.SIMD
    Infrastructure.CPU.Types
    LLM.Adapter.Interface
    LLM.Adapter.Types
    LLM.Providers.DeepSeek
    LLM.Stream
    -- 会话快照落盘（API.Server 直接调用；与 Core.*/LLM.* 同理需在本库重编一份）
    Infrastructure.Storage.SessionStore
    -- ⚠️ trha-gpu-infer 依赖链把 WebGPU 模块带进共享 src 编译面：
    -- 与 trha-llm 的 27 项同理，必须列入否则链接期失败
    Infrastructure.WebGPU.Raw.Types
    Infrastructure.WebGPU.Raw.Enums
    Infrastructure.WebGPU.Raw.Structs
    Infrastructure.WebGPU.Raw.FFI
    Infrastructure.WebGPU.Raw.Async
    Infrastructure.WebGPU.Context
    Infrastructure.WebGPU.Buffer
    Infrastructure.WebGPU.Kernel
    Infrastructure.WebGPU.Error
  hs-source-dirs:   src
  include-dirs:     3rdparty/wgpu-native/include
  c-sources:        cbits/wgpu_callback_shim.c
  extra-libraries:         wgpu_native
  extra-lib-dirs-static:   3rdparty/wgpu-native/lib
  build-depends:    base ^>=4.22
                  , trha:trha-core
                  , trha:trha-llm
                  , trha:trha-gpu-infer
                  , servant
                  , servant-server
                  , tagged
                  , warp
                  , wai
                  , aeson
                  , text
                  , bytestring
                  , stm
                  , containers
                  , http-types
                  , http-client
                  , http-client-tls
                  , vector
                  , async
                  , directory
                  , filepath
  default-language: Haskell2010

