cabal-version:      3.8
name:               trha
version:            0.1.0.0
synopsis:           A microkernel agent harness written in Haskell
license:            MIT
author:             Yanli
build-type:         Simple

-- Core Engine (Haskell/GHC)
library trha-core
  exposed-modules:  
    Core.Plugin.Free
    Core.Plugin.Types
    Core.Session.Types
    Core.Session.Manager
    Core.Agent.Types
    Core.Agent.Modes
    Core.Agent.StateMachine
    Core.Tools.Registry
    Core.Tools.Types
    Core.Event.Bus
    Core.Event.Types
    Core.Cache.Engine
    Core.Cache.Types
  hs-source-dirs:   src
  build-depends:    base ^>=4.22
                  , free
                  , containers
                  , stm
                  , text
                  , bytestring
                  , hashable
                  , aeson
  default-language: Haskell2010

-- LLM Adapters + CPU Backend (merged to avoid GHC 9.14 internal-lib linking bug)
library trha-llm
  exposed-modules:  
    LLM.Adapter.Types
    LLM.Adapter.Interface
    LLM.Providers.DeepSeek
    LLM.Providers.OpenAI
    LLM.Stream
    Infrastructure.CPU.Types
